<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="200"
		MinWidth="900" MinHeight="750"
		Width="900" Height="750"
        x:Class="LibationAvalonia.Dialogs.SettingsDialog"
        xmlns:controls="clr-namespace:LibationAvalonia.Controls"
        xmlns:settings="clr-namespace:LibationAvalonia.Controls.Settings"
        xmlns:vm="clr-namespace:LibationAvalonia.ViewModels.Settings"
		x:DataType="vm:SettingsVM"
        Title="Settings">

	<Grid RowDefinitions="*,Auto">

		<StackPanel
			Grid.Row="1"
			Margin="16"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="8">
			<Button
				Padding="16,6"
				IsCancel="True"
				Content="Cancel"
				Click="CancelButton_Clicked" />
			<Button
				Padding="16,6"
				Classes="Primary"
				Content="Save"
				Name="saveBtn"
				Click="SaveButton_Clicked" />
		</StackPanel>

		<TabControl Name="tabControl" Grid.Column="0">
			<TabControl.Styles>
				<Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
					<Setter Property="Height" Value="30"/>
				</Style>
				<Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
					<Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
					<Setter Property="BorderThickness" Value="1" />
				</Style>
				<Style Selector="TabItem">
					<Setter Property="MinHeight" Value="45"/>
					<Setter Property="Height" Value="45"/>
					<Setter Property="Padding" Value="8,2,8,10"/>
					<Style Selector="^ > TextBlock" >
						<Setter Property="FontSize" Value="14" />
						<Setter Property="VerticalAlignment" Value="Center" />
					</Style>
				</Style>
			</TabControl.Styles>

			<TabItem>
				<TabItem.Header>
					<TextBlock Text="General"/>
				</TabItem.Header>

				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
					<settings:Important DataContext="{Binding ImportantSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="Import"/>
				</TabItem.Header>

				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
					<settings:Import DataContext="{Binding ImportSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>

			<TabItem>
				<TabItem.Header>
					<TextBlock Text="Downloads"/>
				</TabItem.Header>
				
				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
					<settings:DownloadDecrypt DataContext="{Binding DownloadDecryptSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
			
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="Audio"/>
				</TabItem.Header>
				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
					<settings:Audio DataContext="{Binding AudioSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="Audiobookshelf"/>
				</TabItem.Header>
				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
					<settings:Audiobookshelf DataContext="{Binding AudiobookshelfSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
