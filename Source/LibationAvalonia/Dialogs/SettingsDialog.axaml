<Window xmlns="https://github.com/avaloniaui"
		xmlns:res="using:LibationUiBase.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="200"
		MinWidth="900" MinHeight="750"
		Width="900" Height="750"
        x:Class="LibationAvalonia.Dialogs.SettingsDialog"
        xmlns:controls="clr-namespace:LibationAvalonia.Controls"
        xmlns:settings="clr-namespace:LibationAvalonia.Controls.Settings"
        xmlns:vm="clr-namespace:LibationAvalonia.ViewModels.Settings"
		x:DataType="vm:SettingsVM"
        Title="{x:Static res:Strings.SettingsDialog_EditSettings}">

	<Grid RowDefinitions="*,Auto">

		<Button
			Grid.Row="1"
			Margin="10"
			HorizontalAlignment="Right"
			Classes="SaveButton"
			Content="{x:Static res:Strings.SettingsDialog_Save}"
			Name="saveBtn"
			Click="SaveButton_Clicked" />

		<TabControl Name="tabControl" Grid.Column="0">
			<!-- Tabs are 45 high but sit in a 30 high strip, centered on it. Negative margins do that instead of a fixed
			     height, so long tab names can wrap to a second row without drawing over the page. -->
			<TabControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel Margin="0,-8,0,-7"/>
				</ItemsPanelTemplate>
			</TabControl.ItemsPanel>
			<TabControl.Styles>
				<Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
					<Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
					<Setter Property="BorderThickness" Value="1" />
				</Style>
				<Style Selector="TabItem">
					<Setter Property="MinHeight" Value="45"/>
					<Setter Property="Height" Value="45"/>
					<Setter Property="Padding" Value="8,2,8,10"/>
					<Style Selector="^ > TextBlock" >
						<Setter Property="FontSize" Value="14" />
						<Setter Property="VerticalAlignment" Value="Center" />
					</Style>
				</Style>
			</TabControl.Styles>

			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static res:Strings.SettingsDialog_ImportantSettings}"/>
				</TabItem.Header>

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<settings:Important DataContext="{Binding ImportantSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static res:Strings.SettingsDialog_ImportLibrary}"/>
				</TabItem.Header>

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<settings:Import DataContext="{Binding ImportSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>

			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static res:Strings.SettingsDialog_DownloadDecrypt}"/>
				</TabItem.Header>
				
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<settings:DownloadDecrypt DataContext="{Binding DownloadDecryptSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
			
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="{x:Static res:Strings.SettingsDialog_AudioFileSettings}"/>
				</TabItem.Header>
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<settings:Audio DataContext="{Binding AudioSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<TextBlock Text="Audiobookshelf"/>
				</TabItem.Header>
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<settings:Audiobookshelf DataContext="{Binding AudiobookshelfSettings, Mode=OneTime}" />
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
