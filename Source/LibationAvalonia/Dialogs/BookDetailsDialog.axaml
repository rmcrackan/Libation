<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="720"
		MinWidth="560" MinHeight="480"
		Width="640" Height="720"
        x:Class="LibationAvalonia.Dialogs.BookDetailsDialog"
		xmlns:controls="clr-namespace:LibationAvalonia.Controls"
		xmlns:dialogs="clr-namespace:LibationAvalonia.Dialogs"
		x:DataType="dialogs:BookDetailsDialog+BookDetailsDialogViewModel"
		x:CompileBindings="True"
        Title="Book Details" Name="BookDetails">

	<Window.Styles>
		<Style Selector="SelectableTextBlock">
			<Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
		</Style>
		<Style Selector="Border.Pill">
			<Setter Property="CornerRadius" Value="999" />
			<Setter Property="Padding" Value="10,3" />
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
		</Style>
		<Style Selector="Border.Pill > TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
		</Style>
		<Style Selector="Border.Pill.Success">
			<Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
		</Style>
		<Style Selector="Border.Pill.Success > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
		</Style>
		<Style Selector="Border.Pill.Warning">
			<Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
		</Style>
		<Style Selector="Border.Pill.Warning > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
		</Style>
		<Style Selector="Border.Pill.Error">
			<Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
		</Style>
		<Style Selector="Border.Pill.Error > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
		</Style>
		<Style Selector="TextBlock.Subhead">
			<Setter Property="FontSize" Value="16" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>
		<Style Selector="TextBlock.Caption">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="24" Spacing="24">

				<Grid ColumnDefinitions="Auto,*">
					<StackPanel Spacing="8" VerticalAlignment="Top">
						<Border CornerRadius="6" ClipToBounds="True" Width="96" Height="96">
							<Image Source="{Binding Cover}" Stretch="UniformToFill" />
						</Border>
						<Path
							HorizontalAlignment="Center"
							Stretch="Uniform"
							Width="72"
							Fill="{DynamicResource IconFill}"
							IsVisible="{Binding IsSpatial}"
							Data="{StaticResource DolbyAtmosLogoVertical}" />
					</StackPanel>

					<StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2">
						<SelectableTextBlock
							Text="{Binding TitleText}"
							FontSize="20"
							FontWeight="SemiBold"
							TextWrapping="Wrap" />
						<SelectableTextBlock
							Text="{Binding Subtitle}"
							IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							FontSize="14"
							Foreground="{DynamicResource SecondaryForegroundBrush}"
							TextWrapping="Wrap" />
						<Button
							Classes="Ghost"
							Padding="0,2"
							HorizontalAlignment="Left"
							Command="{Binding OpenInAudibleCommand}"
							Content="View on Audible" />
						<TextBlock
							Text="{Binding SeriesLine}"
							IsVisible="{Binding SeriesLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							FontSize="14"
							Foreground="{DynamicResource SecondaryForegroundBrush}"
							TextWrapping="Wrap" />
						<SelectableTextBlock
							Text="{Binding AuthorNames}"
							FontSize="14"
							TextWrapping="Wrap" />
						<Border
							Classes="Pill"
							Classes.Success="{Binding StatusIsSuccess}"
							Classes.Warning="{Binding StatusIsWarning}"
							Classes.Error="{Binding StatusIsError}"
							Margin="0,8,0,0">
							<TextBlock Text="{Binding StatusText}" />
						</Border>
					</StackPanel>
				</Grid>

				<StackPanel>
					<TextBlock Classes="Subhead" Text="Details" />
					<ItemsControl ItemsSource="{Binding Details}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="dialogs:BookDetailsDialog+DetailItem">
								<Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
									<TextBlock
										Text="{Binding Label}"
										FontSize="14"
										Foreground="{DynamicResource SecondaryForegroundBrush}" />
									<SelectableTextBlock
										Grid.Column="1"
										Text="{Binding Value}"
										FontSize="14"
										Classes.Mono="{Binding IsMono}"
										TextWrapping="Wrap" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Grid ColumnDefinitions="120,*,Auto" IsVisible="{Binding ShortFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
						<TextBlock
							Text="File"
							FontSize="14"
							VerticalAlignment="Center"
							Foreground="{DynamicResource SecondaryForegroundBrush}" />
						<SelectableTextBlock
							Grid.Column="1"
							Text="{Binding ShortFilePath}"
							ToolTip.Tip="{Binding FilePath}"
							FontFamily="Menlo,Consolas,monospace"
							FontSize="12"
							VerticalAlignment="Center"
							TextWrapping="Wrap" />
						<Button
							Grid.Column="2"
							Classes="Ghost"
							Margin="8,0,0,0"
							Command="{Binding ShowFileCommand}"
							Content="{Binding ShowFileText}" />
					</Grid>
				</StackPanel>

				<StackPanel>
					<TextBlock Classes="Subhead" Text="Tags" />
					<controls:TagChipEditor Name="tagEditor" Tags="{Binding Tags, Mode=TwoWay}" />
					<TextBlock
						Classes="Caption"
						Margin="0,4,0,0"
						Text="Letters, numbers, and underscores. Press Enter, Space, or comma to add." />
				</StackPanel>

				<StackPanel ToolTip.Tip="Whether the book and PDF have been downloaded">
					<TextBlock Classes="Subhead" Text="Download status" />
					<Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
						<TextBlock
							Text="Audiobook"
							FontSize="14"
							VerticalAlignment="Center"
							Margin="0,0,12,0" />
						<controls:WheelComboBox
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center"
							SelectionChanged="BookStatus_SelectionChanged"
							SelectedItem="{Binding BookLiberatedSelectedItem, Mode=TwoWay}"
							ItemsSource="{Binding BookLiberatedItems}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock FontSize="14" Text="{Binding Text}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</controls:WheelComboBox>

						<TextBlock
							Grid.Column="2"
							Text="PDF"
							FontSize="14"
							VerticalAlignment="Center"
							Margin="24,0,12,0"
							IsVisible="{Binding HasPDF}" />
						<controls:WheelComboBox
							Grid.Column="3"
							IsVisible="{Binding HasPDF}"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center"
							SelectedItem="{Binding PdfLiberatedSelectedItem, Mode=TwoWay}"
							ItemsSource="{Binding PdfLiberatedItems}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock FontSize="14" Text="{Binding Text}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</controls:WheelComboBox>
					</Grid>
					<TextBlock
						Classes="Caption"
						Margin="0,8,0,0"
						TextWrapping="Wrap"
						Text="Change this only if the files were moved or deleted outside Libation." />
				</StackPanel>

			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
			<StackPanel
				Orientation="Horizontal"
				HorizontalAlignment="Right"
				Spacing="8"
				Margin="24,16">

				<Button
					Padding="16,6"
					Content="Cancel"
					IsCancel="True"
					Click="CancelButton_Clicked" />

				<Button
					Padding="16,6"
					Content="Save"
					Classes="Primary"
					Click="SaveButton_Clicked" />
			</StackPanel>
		</Border>
	</Grid>
</Window>
