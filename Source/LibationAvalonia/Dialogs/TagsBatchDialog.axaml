<Window xmlns="https://github.com/avaloniaui"
		xmlns:res="using:LibationUiBase.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="630" d:DesignHeight="90"		
        x:Class="LibationAvalonia.Dialogs.TagsBatchDialog"
		xmlns:dialogs="clr-namespace:LibationAvalonia.Dialogs"
		x:DataType="dialogs:TagsBatchDialog"
		MinWidth="630" MinHeight="90"
		MaxWidth="630" MaxHeight="90"
		Width="630" Height="110"
        Title="{x:Static res:Strings.TagsBatchDialog_ReplaceTags}"
		WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="10">
		<TextBlock
			Grid.ColumnSpan="2"
			Margin="0,0,0,10"
			Text="{x:Static res:Strings.TagsBatchDialog_TagsAreSeparatedByASpace}"/>
		<TextBox
			Grid.Row="1"
			MinHeight="25"
			Name="EditTagsTb"
			Text="{Binding NewTags, Mode=TwoWay}" />
		<Button
			Grid.Row="1"
			Grid.Column="1"
			Margin="10,0,0,0"
			Classes="SaveButton"
			VerticalAlignment="Stretch"
			Content="{x:Static res:Strings.TagsBatchDialog_Save}"
			Command="{Binding SaveAndClose}"/>
	</Grid>
</Window>
