<Window xmlns="https://github.com/avaloniaui"
		xmlns:res="using:LibationUiBase.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:LibationAvalonia.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="LibationAvalonia.Dialogs.SetupDialog"
		WindowStartupLocation="CenterScreen"
		Width="500" Height="350"
		Icon="/Assets/libation.ico"
        Title="{x:Static res:Strings.SetupDialog_WelcomeToLibation}"
		ShowInTaskbar="True"
		x:DataType="dialogs:SetupDialog">

	<Grid
		Margin="10"
		HorizontalAlignment="Stretch"
		RowDefinitions="*,Auto,Auto">
		
		<ScrollViewer Grid.Row="0">
			<TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SetupDialog_ThisAppearsToBeYourFirst}" />
		</ScrollViewer>

		<Grid
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			ColumnDefinitions="*,Auto"
			Margin="0,0,0,10">

			<Button
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Center"
				Padding="0,20"
				Margin="0,0,10,0"
				Click="NewUser_Click">

				<TextBlock
					FontSize="18"
					TextAlignment="Center"
					Text="{x:Static res:Strings.SetupDialog_NEWUSER}"/>

			</Button>

			<Grid
				Grid.Column="1"
				RowDefinitions="*,*">
				
			<TextBlock
				VerticalAlignment="Top"
				Text="{x:Static res:Strings.SetupDialog_Theme}" />
			
			<ComboBox
				Grid.Row="1"
				VerticalAlignment="Bottom"
				SelectedIndex="0"
				SelectedItem="{Binding SelectedTheme, Mode=OneWayToSource}">
				<ComboBox.Items>
                    <ComboBoxItem Content="{x:Static res:Strings.SetupDialog_System}" />
					<ComboBoxItem Content="{x:Static res:Strings.SetupDialog_Light}" />
					<ComboBoxItem Content="{x:Static res:Strings.SetupDialog_Dark}" />
				</ComboBox.Items>
			</ComboBox>

			</Grid>
		</Grid>
		
		<Button
			Grid.Row="2"
			Width="480"
			Click="ReturningUser_Click">

			<TextBlock
				TextAlignment="Center"
				TextWrapping="Wrap"
				Text="{x:Static res:Strings.SetupDialog_RETURNINGUSERIHavePreviouslyInstalled}"/>
		
		</Button>		
	</Grid>
</Window>
