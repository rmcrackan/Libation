<Window xmlns="https://github.com/avaloniaui"
		xmlns:res="using:LibationUiBase.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
		xmlns:controls="clr-namespace:LibationAvalonia.Controls"
        x:Class="LibationAvalonia.Dialogs.LiberatedStatusBatchManualDialog"
        Title="{x:Static res:Strings.LiberatedStatusBatchManualDialog_LiberatedStatusWhetherTheBookHas}"
		MinWidth="400" MinHeight="100"
		MaxWidth="400" MaxHeight="100"
		Width="400" Height="100"
		xmlns:dialogs="clr-namespace:LibationAvalonia.Dialogs"
		x:DataType="dialogs:LiberatedStatusBatchManualDialog"
		WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

		<TextBlock
			Grid.ColumnSpan="2"
			Margin="10"
			Text="{x:Static res:Strings.LiberatedStatusBatchManualDialog_ToDownloadAgainNextTimeChange}"/>
		
		<StackPanel
			Margin="10,0"
			Grid.Row="1"
			Orientation="Horizontal">

			<TextBlock
				Grid.Column="0"
				Margin="0,0,10,0"
				VerticalAlignment="Center"
				Text="{x:Static res:Strings.LiberatedStatusBatchManualDialog_Book}" />

			<controls:WheelComboBox
				Width="130"
				MinHeight="25"
				Height="25"
				VerticalAlignment="Center"
				SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
				ItemsSource="{Binding BookStatuses}">

				<ComboBox.ItemTemplate>
					<DataTemplate>

						<TextBlock
							FontSize="12"
							Text="{Binding Text}" />

					</DataTemplate>
				</ComboBox.ItemTemplate>
			</controls:WheelComboBox>
		</StackPanel>

		<Button
			Grid.Row="1"
			Grid.Column="1"
			Margin="10,0"
			Classes="SaveButton"
			VerticalAlignment="Stretch"
			HorizontalAlignment="Right"
			Content="{x:Static res:Strings.LiberatedStatusBatchManualDialog_Save}"
			Name="SaveButton"
			Click="SaveButton_Clicked" />
	</Grid>
</Window>
