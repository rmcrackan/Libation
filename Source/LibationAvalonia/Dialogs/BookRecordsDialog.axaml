<Window xmlns="https://github.com/avaloniaui"
		xmlns:res="using:LibationUiBase.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
		Width="700" Height="450"
        x:Class="LibationAvalonia.Dialogs.BookRecordsDialog"
		xmlns:dialogs="clr-namespace:LibationAvalonia.Dialogs"
		x:DataType="dialogs:BookRecordsDialog"
        Title="{x:Static res:Strings.BookRecordsDialog_BookRecordsDialog}">

	<Grid RowDefinitions="*,Auto">
		<DataGrid
			Grid.Row="0"
			CanUserReorderColumns="True"
			CanUserResizeColumns="True"
			CanUserSortColumns="True"
			AutoGenerateColumns="False"
			IsReadOnly="False"
			ItemsSource="{Binding DataGridCollectionView}"
			GridLinesVisibility="All">

			<DataGrid.Styles>
				<Style Selector="DataGridColumnHeader">
					<Setter Property="HorizontalContentAlignment" Value="Center" />
				</Style>
				<Style Selector="DataGridCell">
					<Setter Property="HorizontalContentAlignment" Value="Center" />
				</Style>
			</DataGrid.Styles>

			<DataGrid.Columns>
				<DataGridCheckBoxColumn
					Width="Auto"
					IsReadOnly="False"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding IsChecked, Mode=TwoWay}"
					Header="{x:Static res:Strings.BookRecordsDialog_Checked}"/>
				<DataGridTextColumn
					Width="Auto"
					IsReadOnly="True"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding Type}"
					Header="{x:Static res:Strings.BookRecordsDialog_Type}"/>
				<DataGridTextColumn
					Width="Auto"
					IsReadOnly="True"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding Created}"
					Header="{x:Static res:Strings.BookRecordsDialog_Created}"/>
				<DataGridTextColumn
					Width="Auto"
					IsReadOnly="True"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding Start}"
					Header="{x:Static res:Strings.BookRecordsDialog_Start}"/>
				<DataGridTextColumn
					Width="Auto"
					IsReadOnly="True"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding Modified}"
					Header="{x:Static res:Strings.BookRecordsDialog_Modified}"/>
				<DataGridTextColumn
					Width="Auto"
					IsReadOnly="True"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding End}"
					Header="{x:Static res:Strings.BookRecordsDialog_End}"/>
				<DataGridTextColumn
					Width="Auto"
					IsReadOnly="True"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding Note}"
					Header="{x:Static res:Strings.BookRecordsDialog_Note}"/>
				<DataGridTextColumn
					Width="Auto"
					IsReadOnly="True"
					x:DataType="dialogs:BookRecordsDialog+BookRecordEntry"
					Binding="{Binding Title}"
					Header="{x:Static res:Strings.BookRecordsDialog_Title}"/>



			</DataGrid.Columns>
		</DataGrid>
		<Grid
			Grid.Row="1"
			Margin="10"
			ColumnDefinitions="Auto,Auto,*,Auto"
			RowDefinitions="Auto,Auto">
			<Grid.Styles>
				<Style Selector="Button">
					<Setter Property="HorizontalAlignment" Value="Stretch"/>
					<Setter Property="HorizontalContentAlignment" Value="Center"/>
					<Setter Property="Margin" Value="0,10,0,0"/>
					<Setter Property="Height" Value="30"/>
				</Style>
			</Grid.Styles>

			<Button
				Grid.Column="0"
				Grid.Row="0"
				Content="{x:Static res:Strings.BookRecordsDialog_CheckAll}"
				Command="{Binding CheckAll}"/>

			<Button
				Grid.Column="0"
				Grid.Row="1"
				Content="{x:Static res:Strings.BookRecordsDialog_UncheckAll}"
				Command="{Binding UncheckAll}"/>
			
			<Button
				Grid.Column="1"
				Grid.Row="0"
				Margin="20,10,0,0"
				Content="{x:Static res:Strings.BookRecordsDialog_DeleteChecked}"
				Click="DeleteChecked_Click"/>

			<Button
				Grid.Column="1"
				Grid.Row="1"
				Margin="20,10,0,0"
				Content="{x:Static res:Strings.BookRecordsDialog_ReloadAll}"
				Click="ReloadAll_Click"/>

			<Button
				Grid.Column="3"
				Grid.Row="0"
				Content="{x:Static res:Strings.BookRecordsDialog_ExportChecked}"
				Click="ExportChecked_Click"/>

			<Button
				Grid.Column="3"
				Grid.Row="1"
				Content="{x:Static res:Strings.BookRecordsDialog_ExportAll}"
				Click="ExportAll_Click"/>
		</Grid>
	</Grid>
</Window>
