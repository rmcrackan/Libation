<Window xmlns="https://github.com/avaloniaui"
		xmlns:res="using:LibationUiBase.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800" Height="450"
		xmlns:dialogs="clr-namespace:LibationAvalonia.Dialogs"
		x:DataType="dialogs:AccountsDialog"
        x:Class="LibationAvalonia.Dialogs.AccountsDialog"
        Title="{x:Static res:Strings.AccountsDialog_AudibleAccounts}">
	<Grid RowDefinitions="*,Auto">
		<DataGrid
			Grid.Row="0"
			CanUserReorderColumns="False"
			CanUserResizeColumns="False"
			CanUserSortColumns="False"
			AutoGenerateColumns="False"
			IsReadOnly="False"
			Name="accountsGrid"
			ItemsSource="{Binding Accounts}"
			GridLinesVisibility="All">

			<DataGrid.Columns>

				<DataGridTemplateColumn Header="{x:Static res:Strings.AccountsDialog_Delete}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<Button
								Content="X"
								VerticalAlignment="Stretch"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								IsEnabled="{Binding !IsDefault}"
								Click="DeleteButton_Clicked" />

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Header="{x:Static res:Strings.AccountsDialog_Export}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<Button
								Content="{x:Static res:Strings.AccountsDialog_Export}"
								VerticalAlignment="Stretch"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								IsEnabled="{Binding CanExport}"
								ToolTip.Tip="{Binding ExportButtonToolTip}"
								Click="ExportButton_Clicked" />

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridCheckBoxColumn
					Binding="{Binding LibraryScan, Mode=TwoWay}"
					Header="{x:Static res:Strings.AccountsDialog_IncludeInLibraryScan}"/>

				<DataGridTemplateColumn Header="{x:Static res:Strings.AccountsDialog_SignedIn}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<CheckBox
								IsChecked="{Binding SignedIn, Mode=TwoWay}"
								IsThreeState="True"
								IsEnabled="{Binding CanToggleSignedIn}"
								ToolTip.Tip="{Binding SignedInToolTip}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn
					Width="2*"
					MinWidth="150"
					Binding="{Binding AccountId, Mode=TwoWay}"
					Header="{x:Static res:Strings.AccountsDialog_AudibleEmailLogin}"/>

				<DataGridTemplateColumn Width="Auto" Header="{x:Static res:Strings.AccountsDialog_Locale}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ComboBox
							  MinHeight="30"
							  HorizontalContentAlignment = "Stretch"
							  HorizontalAlignment = "Stretch"
							  SelectedItem="{Binding SelectedLocale, Mode=TwoWay}"
							  ItemsSource="{Binding Locales}">

								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock ZIndex="2"
											FontSize="12"
											Text="{Binding Name}" />

									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTemplateColumn Width="Auto" Header="{x:Static res:Strings.AccountsDialog_Marketplaces}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<Button
								Content="{Binding MarketplacesButtonText}"
								VerticalAlignment="Stretch"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								IsEnabled="{Binding CanCheckMarketplaces}"
								ToolTip.Tip="{Binding MarketplacesButtonToolTip}"
								Click="MarketplacesButton_Clicked" />

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn
					Width="Auto"
					Binding="{Binding AccountName, Mode=TwoWay}"
					Header="{x:Static res:Strings.AccountsDialog_AccountNicknameOptional}"/>

			</DataGrid.Columns>
		</DataGrid>
		<Grid
			Grid.Row="1"
			Margin="10"
			ColumnDefinitions="*,Auto" >

			<Button
				Grid.Column="0"
				Content="{x:Static res:Strings.AccountsDialog_ImportFromAudibleCli}"
				Click="ImportButton_Clicked" />

			<Button
				Grid.Column="1"
				Classes="SaveButton"
				Content="{x:Static res:Strings.AccountsDialog_Save}"
				Click="SaveButton_Clicked" />
		</Grid>
	</Grid>
</Window>
