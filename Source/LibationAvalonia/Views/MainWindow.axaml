<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="https://github.com/avaloniaui"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:LibationAvalonia.ViewModels"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:LibationAvalonia.Views"
		xmlns:controls="clr-namespace:LibationAvalonia.Controls"
		mc:Ignorable="d" d:DesignWidth="1850" d:DesignHeight="700"
		x:Class="LibationAvalonia.Views.MainWindow"
		Title="Libation: Liberate your Library"
		x:DataType="vm:MainVM"
		Name="Form1"
		Icon="/Assets/libation.ico">

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="Import">
				<NativeMenu>
					<NativeMenuItem
						Header="Auto Scan Library"
						Command="{Binding ToggleAutoScan}"
						IsChecked="{Binding AutoScanChecked}"
						ToggleType="CheckBox" />
					<NativeMenuItemSeparator />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Liberate">
				<NativeMenu>
					<NativeMenuItem Command="{Binding BackupAllBooks}" Header="{Binding BookBackupsToolStripText}" Gesture="{OnPlatform macOS='alt+⌘+B'}" />
					<NativeMenuItem Command="{Binding BackupAllPdfs}" Header="{Binding PdfBackupsToolStripText}"  Gesture="{OnPlatform macOS='alt+⌘+P'}"/>
					<NativeMenuItem Command="{Binding ConvertAllToMp3Async}" Header="Convert all M4b to Mp3 [Long-running]..." />
					<NativeMenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText}" IsEnabled="{Binding AnyVisibleNotLiberated}" />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Export">
				<NativeMenu>
					<NativeMenuItem Command="{Binding ExportLibraryAsync}" Header="Export Library" Gesture="{OnPlatform macOS='alt+⌘+X'}"/>
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Quick Filters">
				<NativeMenu>
					<NativeMenuItem
						Header="Start Libation with 1st filter Default"
						Command="{Binding ToggleFirstFilterIsDefault}"
						IsChecked="{Binding FirstFilterIsDefault}"
						ToggleType="CheckBox" />
					<NativeMenuItem Command="{Binding EditQuickFiltersAsync}" Header="Edit quick filters..." Gesture="{OnPlatform macOS='alt+⌘+Q'}" />
					<NativeMenuItemSeparator />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Visible Books">
				<NativeMenu>
					<NativeMenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText_2}" IsEnabled="{Binding AnyVisibleNotLiberated}" Gesture="{OnPlatform macOS='alt+⌘+V'}" />
					<NativeMenuItem Command="{Binding ReplaceTagsAsync}" Header="Replace Tags..." />
					<NativeMenuItem Command="{Binding SetBookDownloadedAsync}" Header="Set book 'Downloaded' status manually..." />
					<NativeMenuItem Command="{Binding SetPdfDownloadedAsync}" Header="Set PDF 'Downloaded' status manually..." />
					<NativeMenuItem Command="{Binding SetDownloadedAutoAsync}" Header="Set 'Downloaded' status automatically..." />
					<NativeMenuItem Command="{Binding RemoveVisibleAsync}" Header="Remove from library..." />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Tools">
				<NativeMenu>
					<NativeMenuItem Command="{Binding ShowTrashBinAsync}" Header="{Binding TrashBinMenuText}" Gesture="{OnPlatform macOS='alt+⌘+T'}" />
					<NativeMenuItem Command="{Binding LaunchHangover}" Header="Launch Hangover" />
					<NativeMenuItemSeparator />
					<NativeMenuItem Command="{Binding ShowFindBetterQualityBooksAsync}" Header="Scan for Better Quality Audiobooks" />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Help">
				<NativeMenu>
					<NativeMenuItem Command="{Binding StartWalkthroughAsync}" Header="Take a Guided Tour of Libation" />
				</NativeMenu>
			</NativeMenuItem>
		</NativeMenu>
	</NativeMenu.Menu>

	<Grid RowDefinitions="Auto,*">
		<Border Grid.Row="0" IsVisible="{Binding MenuBarVisible}" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1">
			<Grid ColumnDefinitions="*,Auto">
			<!-- Menu Strip -->
			<Menu VerticalAlignment="Top" IsVisible="{Binding MenuBarVisible}">
					
				<!-- Decrease height of menu strop -->					
				<Menu.Styles>
					<Style Selector="Menu /template/ ItemsPresenter#PART_ItemsPresenter">
						<Setter Property="Height" Value="25"/>
					</Style>
				</Menu.Styles>

				<!-- Import Menu -->
					
				<MenuItem Name="importToolStripMenuItem" Header="_Import">
					<MenuItem IsVisible="{Binding AnyAccounts}" Command="{Binding ToggleAutoScan}" Header="A_uto Scan Library">
						<MenuItem.Icon>
							<CheckBox BorderThickness="0" IsChecked="{Binding AutoScanChecked, Mode=TwoWay}" IsHitTestVisible="False" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem IsVisible="{Binding !AnyAccounts}" Command="{Binding AddAccountsAsync}" Header="No accounts yet. A_dd Account..." />
						
					<!-- Scan Library -->
					<MenuItem IsVisible="{Binding OneAccount}" IsEnabled="{Binding !ActivelyScanning}" Name="scanLibraryToolStripMenuItem" Command="{Binding ScanAccountAsync}" Header="Scan _Library" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding !ActivelyScanning}" Name="scanLibraryOfAllAccountsToolStripMenuItem" Command="{Binding ScanAllAccountsAsync}" Header="Scan Library of _All Accounts" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding !ActivelyScanning}" Command="{Binding ScanSomeAccountsAsync}" Header="Scan Library of _Some Accounts" />
						
					<Separator IsVisible="{Binding AnyAccounts}" />
						
					<!-- Remove Books -->
					<MenuItem IsVisible="{Binding OneAccount}" IsEnabled="{Binding RemoveMenuItemsEnabled}" Command="{Binding RemoveBooksAsync}" Header="_Remove Library Books" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding RemoveMenuItemsEnabled}" Command="{Binding RemoveBooksAllAsync}" Header="Remove Books from All Accounts" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding RemoveMenuItemsEnabled}" Command="{Binding RemoveBooksSomeAsync}" Header="Remove Books from Some Accounts" />
						
					<Separator />
					<MenuItem Command="{Binding LocateAudiobooksAsync}" Header="L_ocate Audiobooks..." ToolTip.Tip="{Binding LocateAudiobooksTip}" />

				</MenuItem>
					
				<!-- Liberate Menu -->

				<MenuItem Header="_Liberate">
					<MenuItem Command="{Binding BackupAllBooks}" Header="{Binding BookBackupsToolStripText}" />
					<MenuItem Command="{Binding BackupAllPdfs}" Header="{Binding PdfBackupsToolStripText}" />
					<MenuItem Command="{Binding ConvertAllToMp3Async}" Header="Convert all _M4b to Mp3 [Long-running]..." />
					<MenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText}" IsEnabled="{Binding AnyVisibleNotLiberated}" />
				</MenuItem>

				<!-- Export Menu -->

				<MenuItem Header="E_xport">
					<!-- Remove height style property for menu item -->
					<MenuItem IsEnabled="{Binding LibraryStats?.HasBookResults, TargetNullValue=false}" Command="{Binding ExportLibraryAsync}" Header="E_xport Library" InputGesture="ctrl+S" />
				</MenuItem>

				<!-- Quick Filters Menu -->

				<MenuItem Name="quickFiltersToolStripMenuItem" Header="Quick _Filters" ItemsSource="{Binding QuickFilterMenuItems}" />

				<!-- Visible Books Menu -->

				<MenuItem Header="{Binding VisibleCountMenuItemText}" >
					<MenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText_2}" IsEnabled="{Binding AnyVisibleNotLiberated}" />
					<MenuItem Command="{Binding ReplaceTagsAsync}" Header="Replace _Tags..." />
					<MenuItem Command="{Binding SetBookDownloadedAsync}" Header="Set book '_Downloaded' status manually..." />
					<MenuItem Command="{Binding SetPdfDownloadedAsync}" Header="Set _PDF 'Downloaded' status manually..." />
					<MenuItem Command="{Binding SetDownloadedAutoAsync}" Header="Set '_Downloaded' status automatically..." />
					<MenuItem Command="{Binding RemoveVisibleAsync}" Header="_Remove from library..." />
				</MenuItem>

				<!-- Settings Menu -->

				<MenuItem Header="_Settings" Name="settingsToolStripMenuItem">
					<MenuItem Name="accountsToolStripMenuItem" Command="{Binding ShowAccountsAsync}" Header="_Accounts..." InputGesture="ctrl+shift+A"/>
					<MenuItem Name="basicSettingsToolStripMenuItem" Command="{Binding ShowSettingsAsync}" Header="_Settings..." InputGesture="ctrl+P" />
					<Separator />
					<MenuItem Command="{Binding ShowTrashBinAsync}" Header="{Binding TrashBinMenuText}" />
					<MenuItem Command="{Binding LaunchHangover}" Header="Launch _Hangover" />
					<Separator />
					<MenuItem Command="{Binding ShowFindBetterQualityBooksAsync}" Header="Scan for Better Quality Audiobooks"  ToolTip.Tip="{Binding FindBetterQualityBooksTip}"/>
					<Separator />
					<MenuItem Command="{Binding StartWalkthroughAsync}" Header="Take a Guided _Tour of Libation" />
					<MenuItem Command="{Binding ShowAboutAsync}" Header="A_bout..." />
				</MenuItem>
			</Menu>
				
		</Grid>
		</Border>
		<Grid Grid.Row="1" ColumnDefinitions="Auto,*">
		<Grid.Styles>
			<Style Selector="Border.SlidePanel">
				<Setter Property="Width" Value="0" />
				<Setter Property="ClipToBounds" Value="True" />
				<Setter Property="Transitions">
					<Transitions>
						<DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
					</Transitions>
				</Setter>
			</Style>
			<Style Selector="Border.SlidePanel.left.open">
				<Setter Property="Width" Value="220" />
			</Style>
			<Style Selector="Border.SlidePanel.right.open">
				<Setter Property="Width" Value="340" />
			</Style>
		</Grid.Styles>
		<Border Grid.Column="0" Classes="SlidePanel left" Classes.open="{Binding SidebarOpen}" IsHitTestVisible="{Binding SidebarOpen}">
			<views:LibrarySidebar Name="librarySidebar" Width="220" HorizontalAlignment="Left" />
		</Border>
		<Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
		<Grid Grid.Row="0" Margin="12,8" ColumnDefinitions="Auto,*,Auto" MinHeight="36">
			<Grid.Styles>
				<Style Selector="Button.IconBtn">
					<Setter Property="Padding" Value="8" />
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="BorderThickness" Value="0" />
					<Setter Property="CornerRadius" Value="6" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.active /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
					</Style>
				</Style>
				<Style Selector="Button.IconBtn Path">
					<Setter Property="Stroke" Value="{DynamicResource IconFill}" />
					<Setter Property="StrokeThickness" Value="1.6" />
					<Setter Property="StrokeLineCap" Value="Round" />
					<Setter Property="StrokeJoin" Value="Round" />
					<Setter Property="Stretch" Value="Uniform" />
					<Setter Property="Width" Value="16" />
					<Setter Property="Height" Value="16" />
				</Style>
			</Grid.Styles>

			<Button Grid.Column="0" Classes="IconBtn" Classes.active="{Binding SidebarOpen}" Margin="0,0,8,0" Command="{Binding ToggleSidebarBtn}" ToolTip.Tip="Toggle sidebar">
				<Path Data="M4,4 L20,4 L20,20 L4,20 Z M9,4 L9,20" />
			</Button>

			<Grid Grid.Column="1" ColumnDefinitions="*,Auto" IsVisible="{Binding !RemoveButtonsVisible}">
				<TextBox
					Grid.Column="0"
					Name="filterSearchTb"
					VerticalAlignment="Center"
					PlaceholderText="Search title, author, narrator…  try author:austen"
					ScrollViewer.HorizontalScrollBarVisibility="Auto"
					ScrollViewer.VerticalScrollBarVisibility="Disabled"
					Text="{Binding SelectedNamedFilter.Filter, Mode=OneWay}"
					KeyDown="filterSearchTb_KeyPress">
					<TextBox.InnerRightContent>
						<Button
							Classes="Ghost"
							Padding="8,2"
							VerticalAlignment="Center"
							Click="ClearFilterButton_Click"
							Content="×"
							ToolTip.Tip="Clear search" />
					</TextBox.InnerRightContent>
				</TextBox>
				<Button
					Grid.Column="1"
					Name="filterHelpBtn"
					Classes="Ghost"
					Margin="4,0,0,0"
					VerticalAlignment="Center"
					Command="{Binding FilterHelpBtn}"
					Content="Syntax" />
			</Grid>

			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding RemoveButtonsVisible}">
				<Button IsEnabled="{Binding RemoveBooksButtonEnabled}" Command="{Binding RemoveBooksBtn}" Content="{Binding RemoveBooksButtonText}"/>
				<Button Command="{Binding DoneRemovingBtn}" Content="Done Removing Books"/>
			</StackPanel>

			<StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !RemoveButtonsVisible}">
					<SplitButton
						IsVisible="{Binding OneAccount}"
						IsEnabled="{Binding !ActivelyScanning}"
						Command="{Binding ScanAccountAsync}"
						Content="Scan library">
						<SplitButton.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Command="{Binding ToggleAutoScan}" Header="Scan automatically">
									<MenuItem.Icon>
										<CheckBox BorderThickness="0" IsChecked="{Binding AutoScanChecked, Mode=TwoWay}" IsHitTestVisible="False" />
									</MenuItem.Icon>
								</MenuItem>
							</MenuFlyout>
						</SplitButton.Flyout>
					</SplitButton>
					<SplitButton
						IsVisible="{Binding MultipleAccounts}"
						IsEnabled="{Binding !ActivelyScanning}"
						Command="{Binding ScanAllAccountsAsync}"
						Content="Scan library">
						<SplitButton.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Command="{Binding ScanSomeAccountsAsync}" Header="Scan some accounts…" />
								<MenuItem Command="{Binding ToggleAutoScan}" Header="Scan automatically">
									<MenuItem.Icon>
										<CheckBox BorderThickness="0" IsChecked="{Binding AutoScanChecked, Mode=TwoWay}" IsHitTestVisible="False" />
									</MenuItem.Icon>
								</MenuItem>
							</MenuFlyout>
						</SplitButton.Flyout>
					</SplitButton>
					<SplitButton
						Classes="Primary"
						IsVisible="{Binding LiberateAllVisible}"
						Command="{Binding BackupAllBooks}"
						Content="{Binding LiberateAllText}">
						<SplitButton.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Command="{Binding BackupAllPdfs}" Header="{Binding PdfOnlyText}" />
								<MenuItem Command="{Binding ConvertAllToMp3Async}" Header="Convert all M4B to MP3…" />
							</MenuFlyout>
						</SplitButton.Flyout>
					</SplitButton>
				</StackPanel>

				<Button Classes="IconBtn" Classes.active="{Binding InspectorOpen}" Command="{Binding ToggleInspectorBtn}" ToolTip.Tip="Show panel">
					<Path Data="M4,4 L20,4 L20,20 L4,20 Z M15,4 L15,20" />
				</Button>
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
			<Panel Grid.Column="0">
				<views:ProductsDisplay
					Name="productsDisplay"
					DataContext="{Binding ProductsDisplay, Mode=OneTime}"
					LiberateClicked="ProductsDisplay_LiberateClicked"
					TagsButtonClicked="ProductsDisplay_TagsButtonClicked"
					LiberateSeriesClicked="ProductsDisplay_LiberateSeriesClicked"
					ConvertToMp3Clicked="ProductsDisplay_ConvertToMp3Clicked" />

					<!-- Trashed books are filtered out of the library and the search index, so say so rather than leaving the grid blank. -->
					<StackPanel
						IsVisible="{Binding NoMatchesVisible}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="8">
						<Path
							Width="40"
							Height="40"
							Stretch="Uniform"
							HorizontalAlignment="Center"
							Data="{StaticResource NoMatchesIcon}"
							Stroke="{DynamicResource SecondaryForegroundBrush}"
							StrokeThickness="2"
							StrokeLineCap="Round"
							StrokeJoin="Round" />
						<TextBlock
							FontSize="18"
							FontWeight="SemiBold"
							HorizontalAlignment="Center"
							Text="No books match" />
						<TextBlock
							IsVisible="{Binding NoMatchesQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							FontFamily="Menlo, Consolas, monospace"
							FontSize="12"
							MaxWidth="480"
							HorizontalAlignment="Center"
							TextTrimming="CharacterEllipsis"
							Foreground="{DynamicResource SecondaryForegroundBrush}"
							Text="{Binding NoMatchesQuery}" />
						<TextBlock
							FontSize="14"
							HorizontalAlignment="Center"
							Foreground="{DynamicResource SecondaryForegroundBrush}"
							Text="Try fewer terms, or check the filter syntax." />
						<StackPanel
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,8,0,0"
							Spacing="8">
							<Button Padding="16,6" Click="ClearAllFilters_Click" Content="Clear filters" />
							<Button Padding="16,6" Classes="Ghost" Command="{Binding FilterHelpBtn}" Content="Filter syntax" />
						</StackPanel>
						<StackPanel
							IsVisible="{Binding NoMatchesTrashHintVisible}"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,8,0,0"
							Spacing="8">
							<TextBlock
								FontSize="14"
								VerticalAlignment="Center"
								Foreground="{DynamicResource SecondaryForegroundBrush}"
								Text="{Binding NoMatchesTrashHintText}" />
							<Button
								Padding="12,4"
								Classes="Ghost"
								VerticalAlignment="Center"
								Command="{Binding ShowTrashBinAsync}"
								Content="Open Trash Bin" />
						</StackPanel>
					</StackPanel>

					<!-- An empty library has two causes with different next steps, so offer the one that applies. -->
					<StackPanel
						IsVisible="{Binding GettingStartedVisible}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="8">
						<Path
							Width="40"
							Height="40"
							Stretch="Uniform"
							HorizontalAlignment="Center"
							Data="{StaticResource EmptyLibraryIcon}"
							Stroke="{DynamicResource SecondaryForegroundBrush}"
							StrokeThickness="2"
							StrokeLineCap="Round"
							StrokeJoin="Round" />
						<TextBlock
							FontSize="18"
							FontWeight="SemiBold"
							HorizontalAlignment="Center"
							Text="{Binding GettingStartedHeadline}" />
						<TextBlock
							FontSize="14"
							HorizontalAlignment="Center"
							Foreground="{DynamicResource SecondaryForegroundBrush}"
							Text="{Binding GettingStartedDetail}" />
						<StackPanel
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,8,0,0"
							Spacing="8">
							<Button
								Padding="16,6"
								Classes="Primary"
								IsVisible="{Binding GettingStartedAddAccountVisible}"
								Command="{Binding AddAccountsAsync}"
								Content="Add Account" />
							<Button
								Padding="16,6"
								Classes="Primary"
								IsVisible="{Binding GettingStartedScanVisible}"
								Command="{Binding GettingStartedScanAsync}"
								Content="Scan Library" />
							<Button
								Padding="16,6"
								Classes="Ghost"
								Command="{Binding StartWalkthroughAsync}"
								Content="Take a Guided Tour" />
						</StackPanel>

						<StackPanel
							IsVisible="{Binding GettingStartedTrashVisible}"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,8,0,0"
							Spacing="8">
							<TextBlock
								FontSize="14"
								VerticalAlignment="Center"
								Foreground="{DynamicResource SecondaryForegroundBrush}"
								Text="{Binding GettingStartedTrashText}" />
							<Button
								Padding="12,4"
								Classes="Ghost"
								VerticalAlignment="Center"
								Command="{Binding ShowTrashBinAsync}"
								Content="Open Trash Bin" />
						</StackPanel>
					</StackPanel>
				</Panel>

			<Border Grid.Column="1" Classes="SlidePanel right" Classes.open="{Binding InspectorOpen}" IsHitTestVisible="{Binding InspectorOpen}">
				<Grid
					Width="340"
					HorizontalAlignment="Right"
					RowDefinitions="Auto,*"
					Background="{DynamicResource SystemRegionColor}">
					<Grid.Styles>
						<Style Selector="Button.Seg">
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderThickness" Value="0" />
							<Setter Property="CornerRadius" Value="5" />
							<Setter Property="Padding" Value="0,5" />
							<Setter Property="FontSize" Value="13" />
							<Setter Property="HorizontalAlignment" Value="Stretch" />
							<Setter Property="HorizontalContentAlignment" Value="Center" />
							<Style Selector="^.active /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
								<Setter Property="Foreground" Value="White" />
								<Setter Property="FontWeight" Value="SemiBold" />
							</Style>
							<Style Selector="^:pointerover:not(.active) /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
							</Style>
							<Style Selector="^.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
								<Setter Property="Foreground" Value="White" />
							</Style>
							<Style Selector="^.active TextBlock">
								<Setter Property="Foreground" Value="White" />
							</Style>
							<Style Selector="^.active Border.badge">
								<Setter Property="Background" Value="White" />
							</Style>
							<Style Selector="^.active Border.badge TextBlock">
								<Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
							</Style>
						</Style>
					</Grid.Styles>
					<Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0" IsHitTestVisible="False" ZIndex="1" />
					<Border Grid.Row="0" Margin="12,10,12,6" Padding="2" CornerRadius="7" Background="{DynamicResource NeutralSoftBrush}">
						<Grid ColumnDefinitions="*,*,*">
							<Button Grid.Column="0" Classes="Seg" Classes.active="{Binding DetailsTabActive}" Command="{Binding ShowDetailsTab}" Content="Details" />
							<Button Grid.Column="1" Classes="Seg" Classes.active="{Binding QueueTabActive}" Command="{Binding ShowQueueTab}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock VerticalAlignment="Center" Text="Queue" />
									<Border
										Classes="badge"
										IsVisible="{Binding QueueBadgeVisible}"
										MinWidth="16"
										Height="16"
										Padding="4,0"
										CornerRadius="8"
										Background="{DynamicResource SystemAccentColor}">
										<TextBlock FontSize="12" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding QueueBadgeText}" />
									</Border>
								</StackPanel>
							</Button>
							<Button Grid.Column="2" Classes="Seg" Classes.active="{Binding LogTabActive}" Command="{Binding ShowLogTab}" Content="Log" />
						</Grid>
					</Border>
					<Panel Grid.Row="1">
						<views:BookInspector
							Name="bookInspector"
							IsVisible="{Binding DetailsTabActive}"
							Entry="{Binding SelectedEntry}"
							EmptyText="{Binding InspectorEmptyText}"
							Selection="{Binding SelectedEntries}"
							EditSelectionTagsClicked="BookInspector_EditSelectionTagsClicked"
							LiberateClicked="ProductsDisplay_LiberateClicked"
							DetailsClicked="ProductsDisplay_TagsButtonClicked" />
						<Panel IsVisible="{Binding QueueOpen}">
							<views:ProcessQueueControl
								DataContext="{Binding ProcessQueue, Mode=OneTime}"
								ShowLog="{Binding $parent[Window].((vm:MainVM)DataContext).LogTabActive}" />
						</Panel>
					</Panel>
				</Grid>
			</Border>
		</Grid>

		<!-- Bottom Status Strip -->
		<Grid Grid.Row="2" Margin="16,8" VerticalAlignment="Bottom" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
			<Grid.Styles>
				<Style Selector="ProgressBar:horizontal">
					<Setter Property="MinWidth" Value="100" />
				</Style>
				<Style Selector="Ellipse.statusDot">
					<Setter Property="Width" Value="8" />
					<Setter Property="Height" Value="8" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="StackPanel > StackPanel > TextBlock">
					<Setter Property="FontSize" Value="12" />
					<Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Grid.Styles>
			<TextBlock FontSize="14" Grid.Column="0" Text="Upgrading:" VerticalAlignment="Center" IsVisible="{Binding DownloadProgress, Converter={x:Static ObjectConverters.IsNotNull}}" />
			<ProgressBar Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Stretch" Width="100" Value="{Binding DownloadProgress, TargetNullValue=0}" IsVisible="{Binding DownloadProgress, Converter={x:Static ObjectConverters.IsNotNull}}"/>
			<TextBlock FontSize="12" FontWeight="SemiBold" Grid.Column="2" Margin="0,0,16,0" Text="{Binding BookCountText}" VerticalAlignment="Center" />
			<TextBlock FontSize="12" Grid.Column="3" Margin="-8,0,16,0" IsVisible="{Binding SelectedCountVisible}" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding SelectedCountText}" VerticalAlignment="Center" />
			<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0" VerticalAlignment="Center" IsVisible="{Binding ActivelyScanning}">
				<Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Fill="{DynamicResource IconFill}" Data="{StaticResource ImportIcon}" />
				<TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding ScanningText}" />
			</StackPanel>
			<StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True"
						IsVisible="{Binding StatusCountsVisible}" ToolTip.Tip="{Binding LibraryStats?.StatusString}">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Ellipse Classes="statusDot" Fill="#30A46C" />
					<TextBlock Text="{Binding DownloadedCountText}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Ellipse Classes="statusDot" Fill="#F2555A" />
					<TextBlock Text="{Binding ToDoCountText}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding InProgressCountVisible}">
					<Ellipse Classes="statusDot" Fill="#F5B800" />
					<TextBlock Text="{Binding InProgressCountText}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ErrorCountVisible}">
					<Ellipse Classes="statusDot" Fill="{DynamicResource ErrorForegroundBrush}" />
					<TextBlock Text="{Binding ErrorCountText}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding UnavailableCountVisible}">
					<Ellipse Classes="statusDot" Fill="{DynamicResource SecondaryForegroundBrush}" Opacity="0.6" />
					<TextBlock Text="{Binding UnavailableCountText}" />
				</StackPanel>
			</StackPanel>
			<Button Classes="Ghost" FontSize="12" Grid.Column="6" Margin="16,0,0,0" Padding="8,4" VerticalAlignment="Center"
					Command="{Binding ShowTrashBinAsync}"
					Content="{Binding TrashBinShortText}"
					ToolTip.Tip="{Binding TrashBinStatusToolTip}"
					IsVisible="{Binding TrashBinStatusVisible}" />
		</Grid>
		</Grid>
		</Grid>
	</Grid>
</Window>
