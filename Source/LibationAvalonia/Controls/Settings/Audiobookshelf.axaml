<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             xmlns:controls="clr-namespace:LibationAvalonia.Controls"
             xmlns:vm="clr-namespace:LibationAvalonia.ViewModels.Settings"
             x:DataType="vm:AudiobookshelfSettingsVM"
             x:Class="LibationAvalonia.Controls.Settings.Audiobookshelf">

	<StackPanel Spacing="24">
		<controls:SettingGroup Header="Connection">
			<controls:SettingRow Label="{Binding EnabledText}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding Enabled, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding IncludePdfsText}" IsEnabled="{Binding Enabled}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding IncludePdfs, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding ServerUrlText}">
				<TextBox
					Width="300"
					Text="{Binding ServerUrl, Mode=TwoWay}"
					PlaceholderText="http://localhost:13378"
					IsEnabled="{Binding Enabled}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding ApiTokenText}">
				<TextBox
					Width="300"
					Text="{Binding ApiToken, Mode=TwoWay}"
					PasswordChar="*"
					PlaceholderText="Your ABS API token"
					IsEnabled="{Binding Enabled}" />
			</controls:SettingRow>

			<controls:SettingRow Stacked="True" IsVisible="{Binding PlaintextWarningVisible}">
				<TextBlock
					Text="{Binding PlaintextWarningText}"
					Foreground="{DynamicResource WarningForegroundBrush}"
					TextWrapping="Wrap" />
			</controls:SettingRow>

			<controls:SettingRow Stacked="True">
				<Grid ColumnDefinitions="*,Auto">
					<ProgressBar
						IsIndeterminate="True"
						IsVisible="{Binding IsConnecting}"
						VerticalAlignment="Center" />
					<TextBlock
						Text="{Binding StatusText}"
						TextWrapping="Wrap"
						VerticalAlignment="Center"
						IsVisible="{Binding !IsConnecting}" />
					<Button
						Grid.Column="1"
						Margin="16,0,0,0"
						Content="{Binding ConnectButtonText}"
						Command="{Binding ConnectCommand}"
						IsEnabled="{Binding CanConnect}"
						HorizontalContentAlignment="Center"
						MinWidth="150" />
				</Grid>
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Destination">
			<controls:SettingRow Label="{Binding LibraryText}">
				<ComboBox
					MinWidth="240"
					ItemsSource="{Binding LibraryNames}"
					SelectedIndex="{Binding SelectedLibraryIndex, Mode=TwoWay}"
					IsEnabled="{Binding Enabled}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding FolderText}">
				<ComboBox
					MinWidth="240"
					ItemsSource="{Binding FolderNames}"
					SelectedIndex="{Binding SelectedFolderIndex, Mode=TwoWay}"
					IsEnabled="{Binding Enabled}" />
			</controls:SettingRow>
		</controls:SettingGroup>
	</StackPanel>
</UserControl>
