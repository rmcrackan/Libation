<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
			 xmlns:controls="clr-namespace:LibationAvalonia.Controls"
			 xmlns:vm="clr-namespace:LibationAvalonia.ViewModels.Settings"
			 x:DataType="vm:ImportantSettingsVM"
             x:Class="LibationAvalonia.Controls.Settings.Important">

	<StackPanel Spacing="24">
		<controls:SettingGroup Header="Appearance">
			<controls:SettingRow Label="Theme">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<controls:WheelComboBox
						Name="ThemeComboBox"
						MinWidth="120"
						SelectedItem="{Binding ThemeVariant, Mode=TwoWay}"
						ItemsSource="{Binding Themes}"/>
					<Button
						Padding="16,6"
						Content="Edit Theme Colors"
						Click="EditThemeColors_Click"/>
				</StackPanel>
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding GridScaleFactorText}">
				<Slider
					Width="220"
					Value="{Binding GridScaleFactor, Mode=TwoWay}"
					Minimum="-100"
					Maximum="100"
					IsSnapToTickEnabled="False"
					TickFrequency="25"
					TickPlacement="BottomRight" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding GridFontScaleFactorText}">
				<Slider
					Width="220"
					Value="{Binding GridFontScaleFactor, Mode=TwoWay}"
					Minimum="-100"
					Maximum="100"
					IsSnapToTickEnabled="False"
					TickFrequency="25"
					TickPlacement="BottomRight" />
			</controls:SettingRow>

			<controls:SettingRow>
				<Button
					Padding="16,6"
					Content="Apply Display Settings"
					Command="{Binding ApplyDisplaySettings}"/>
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Signing in">
			<controls:SettingRow
				Label="{Binding UseWebViewText}"
				Description="{Binding UseWebViewSnapMessage}"
				IsEnabled="{Binding !UseWebViewSettingDisabled}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding UseWebView, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow
				Label="{Binding DeviceRegistrationKindText}"
				Description="{Binding DeviceRegistrationReLoginNote}">
				<controls:WheelComboBox
					MinWidth="200"
					SelectedItem="{Binding SelectedDeviceRegistration, Mode=TwoWay}"
					ItemsSource="{Binding DeviceRegistrationOptions}"
					ToolTip.Tip="{Binding DeviceRegistrationKindTip}" />
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Updates">
			<controls:SettingRow
				Label="{Binding CheckForUpgradesAtStartupText}"
				Description="{Binding CheckForUpgradesAtStartupTip}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding CheckForUpgradesAtStartup, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow
				Label="{Binding CheckForPreReleaseText}"
				Description="{Binding CheckForPreReleaseTip}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding CheckForPreRelease, Mode=TwoWay}" />
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Authentication tokens">
			<controls:SettingRow
				Label="{Binding EncryptTokensText}"
				IsEnabled="{Binding CanEditEncryptTokens}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding EncryptTokens, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Stacked="True" IsVisible="{Binding PlaintextWarningVisible}">
				<TextBlock
					Foreground="{DynamicResource ErrorForegroundBrush}"
					Text="{Binding PlaintextWarningText}"
					TextWrapping="Wrap" />
			</controls:SettingRow>

			<controls:SettingRow Stacked="True" IsVisible="{Binding OsStoreUnavailableVisible}">
				<TextBlock
					Foreground="{DynamicResource ErrorForegroundBrush}"
					Text="{Binding OsStoreUnavailableMessage}"
					TextWrapping="Wrap" />
			</controls:SettingRow>

			<controls:SettingRow Stacked="True">
				<StackPanel
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Spacing="8">
					<Button
						Padding="16,6"
						Content="{Binding ExportButtonText}"
						ToolTip.Tip="{Binding ExportButtonToolTip}"
						IsEnabled="{Binding ExportButtonEnabled}"
						Click="ExportMasterKey_Click" />
					<Button
						Padding="16,6"
						Content="{Binding ConvertButtonText}"
						ToolTip.Tip="{Binding ConvertButtonToolTip}"
						IsEnabled="{Binding ConvertButtonEnabled}"
						Command="{Binding ConvertExistingTokensCommand}" />
				</StackPanel>
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Logging">
			<controls:SettingRow Label="Logging level">
				<controls:WheelComboBox
					Width="140"
					SelectedItem="{Binding LoggingLevel, Mode=TwoWay}"
					ItemsSource="{Binding LoggingLevels}" />
			</controls:SettingRow>

			<controls:SettingRow>
				<Button
					Padding="16,6"
					Content="Open Log Folder"
					Command="{Binding OpenLogFolderButton}" />
			</controls:SettingRow>
		</controls:SettingGroup>
	</StackPanel>
</UserControl>
