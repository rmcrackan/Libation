<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
			 xmlns:controls="clr-namespace:LibationAvalonia.Controls"
			 xmlns:vm="clr-namespace:LibationAvalonia.ViewModels.Settings"
			 x:DataType="vm:DownloadDecryptSettingsVM"
             x:Class="LibationAvalonia.Controls.Settings.DownloadDecrypt">

	<StackPanel Spacing="24">
		<controls:SettingGroup Header="Downloading">
			<controls:SettingRow
				Label="{Binding DailyDownloadLimitGroupboxText}"
				Description="{Binding DailyDownloadLimitDescriptionText}">
				<controls:WheelComboBox
					MinWidth="200"
					ToolTip.Tip="{Binding DailyDownloadLimitTip}"
					ItemsSource="{Binding DailyDownloadLimitScopes}"
					SelectedItem="{Binding DailyDownloadLimit}" />
			</controls:SettingRow>

			<controls:SettingRow
				Label="{Binding DailyDownloadLimitQuantityText}"
				IsVisible="{Binding DailyDownloadLimitQuantityVisible}">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<NumericUpDown
						Classes="SmallNumericUpDown"
						MinWidth="140"
						Minimum="1"
						Maximum="2147483647"
						Increment="1"
						FormatString="N0"
						ParsingNumberStyle="Integer"
						Value="{Binding DailyDownloadLimitQuantity, Mode=TwoWay}" />

					<controls:WheelComboBox
						MinWidth="90"
						ItemsSource="{Binding DailyDownloadLimitUnits}"
						SelectedItem="{Binding DailyDownloadLimitUnit}" />
				</StackPanel>
			</controls:SettingRow>

			<controls:SettingRow
				IsVisible="{Binding DailyDownloadLimitApproximateNoteVisible}"
				Description="{Binding DailyDownloadLimitApproximateNoteText}" />
		</controls:SettingGroup>

		<controls:SettingGroup Header="{Binding BadBookGroupboxText}">
			<controls:SettingRow Stacked="True">
				<WrapPanel Orientation="Horizontal">
					<WrapPanel.Styles>
						<Style Selector="RadioButton">
							<Setter Property="Margin" Value="0,0,24,0" />
						</Style>
					</WrapPanel.Styles>
					<RadioButton IsChecked="{Binding BadBookAsk, Mode=TwoWay}" Content="{Binding BadBookAskText}" />
					<RadioButton IsChecked="{Binding BadBookAbort, Mode=TwoWay}" Content="{Binding BadBookAbortText}" />
					<RadioButton IsChecked="{Binding BadBookRetry, Mode=TwoWay}" Content="{Binding BadBookRetryText}" />
					<RadioButton IsChecked="{Binding BadBookIgnore, Mode=TwoWay}" Content="{Binding BadBookIgnoreText}" />
				</WrapPanel>
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Locations">
			<controls:SettingRow
				Stacked="True"
				Label="Temporary files location"
				Description="{Binding InProgressDescriptionText}">
				<controls:DirectoryOrCustomSelectControl
					Directory="{Binding InProgressDirectory, Mode=TwoWay}"
					KnownDirectories="{Binding KnownDirectories}" />
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Files">
			<controls:SettingRow
				Label="{Binding UseCoverAsFolderIconText}"
				IsVisible="{Binding !Config.IsLinux}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding UseCoverAsFolderIcon, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding SaveMetadataToFileText}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding SaveMetadataToFile, Mode=TwoWay}" />
			</controls:SettingRow>
		</controls:SettingGroup>
	</StackPanel>
</UserControl>
