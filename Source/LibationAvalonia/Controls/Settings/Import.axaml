<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
			 xmlns:controls="clr-namespace:LibationAvalonia.Controls"
			 xmlns:vm="clr-namespace:LibationAvalonia.ViewModels.Settings"
			 x:DataType="vm:ImportSettingsVM"
             x:Class="LibationAvalonia.Controls.Settings.Import">

	<StackPanel Spacing="24">
		<controls:SettingGroup Header="Scanning">
			<controls:SettingRow Label="{Binding AutoScanText}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding AutoScan, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding ShowImportedStatsText}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding ShowImportedStats, Mode=TwoWay}" />
			</controls:SettingRow>
		</controls:SettingGroup>

		<controls:SettingGroup Header="Podcasts">
			<controls:SettingRow Label="{Binding ImportEpisodesText}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding ImportEpisodes, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding ImportPlusTitlesText}" Description="{Binding ImportPlusTitlesTip}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding ImportPlusTitles, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding DownloadEpisodesText}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding DownloadEpisodes, Mode=TwoWay}" />
			</controls:SettingRow>

			<controls:SettingRow Label="{Binding AutoDownloadEpisodesText}">
				<ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding AutoDownloadEpisodes, Mode=TwoWay}" />
			</controls:SettingRow>
		</controls:SettingGroup>
	</StackPanel>
</UserControl>
